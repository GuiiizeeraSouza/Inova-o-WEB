# Endereço público do site (canonical, sitemap, Open Graph). Padrão: https://www.inovacaocarros.com.br
NEXT_PUBLIC_SITE_URL=https://www.inovacaocarros.com.br

# ID de métricas do Google Analytics 4 (começa com "G-"). IDs "UA-" não coletam mais dados.
NEXT_PUBLIC_GA_ID=

# Código de verificação do Google Search Console (opcional se verificar pelo DNS)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Avaliações do Google (usadas em /api/google-reviews)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
